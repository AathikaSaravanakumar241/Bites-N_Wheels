# -----------------------------------------------------------------------
# TEMPLATE. Do not edit this file with real values.
#
# 1. Copy it, in the same folder, to:  application-local.properties
# 2. Fill in the real values in that copy.
# 3. That copy is gitignored - never commit it, never paste it in chat.
#
# Then just run:  mvnw spring-boot:run
# (application.properties activates the "local" profile by default)
#
# Supabase: Dashboard -> Connect -> Session pooler.
# Use port 5432. Do NOT use 6543 (transaction pooler) - it breaks
# Hibernate prepared statements.
# -----------------------------------------------------------------------

spring.datasource.url=jdbc:postgresql://YOUR-SUPABASE-HOST:5432/postgres
spring.datasource.username=YOUR-SUPABASE-USER
spring.datasource.password=YOUR-ROTATED-PASSWORD

# Any random string, at least 32 characters (HS256 requirement).
jwt.secret=replace-with-a-long-random-string-at-least-32-chars
